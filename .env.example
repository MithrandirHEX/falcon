# Docker 部署配置（复制为 .env）
FALCON_TAG=latest
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=falcon

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FALCON_LLM_PROVIDER=
FALCON_LLM_MODEL=
FALCON_LLM_BASE_URL=
FALCON_LLM_PROXY=

# CloakBrowser stealth Chromium license（可选：免费 key 在 cloakbrowser.dev 领取，
# 1 并发 session）。留空则镜像构建时回退安装 Playwright 原版 Chromium（无 stealth 补丁）。
CLOAKBROWSER_LICENSE_KEY=
